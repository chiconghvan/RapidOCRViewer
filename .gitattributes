# Normalize line endings - critical for cross-platform CI (fixes \r in version parsing)
* text=auto
# Source and scripts must be LF (macOS/Linux runners fail on CRLF)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.rc text eol=lf
*.nsi text eol=lf
*.nsh text eol=lf
*.ini text eol=lf
# Windows batch keep CRLF
*.bat text eol=crlf
# Binary
*.exe binary
*.dll binary
*.traineddata binary
*.ico binary
*.png binary
*.gif binary
*.zip binary
*.tar.gz binary
*.dmg binary
